    "light": "/images/figranium-dark.svg",
    "dark": "/images/figranium-light.svg",
    "href": "https://figranium.dev"
  },
  "css": "/styles.css",
  "appearance": {
    "strict": false,
    "default": "system"
  },
  "seo": {
    "indexing": "navigable",
    "metatags": {
      "canonical": "https://figranium.dev/docs"
    }
  },
  "integrations": {
    "telemetry": {
      "enabled": true
    }
  },
  "errors": {
    "404": {
      "redirect": false
    }
  },
  "api": {
    "openapi": "openapi.json"
  },
  "markdown": {
    "schema": true
  },
  "icons": {
    "library": "tabler"
  },
  "fonts": {
    "family": "Questrial"
  },
  "description": "Open-source browser automation tools: Figranium Browsers for visual, self-hosted Tasks, Frowse for token-lean agent browsing, Fiptcha for local CAPTCHA solving, and Folate for neural DOM element grounding.",
  "navbar": {
    "primary": {
      "type": "github",
      "href": "https://github.com/figranium"
    }
  },
  "footer": {
    "socials": {
      "discord": "https://discord.com/invite/kPmfbgu9Xn",
      "github": "https://github.com/figranium",
      "x": "https://x.com/figranium",
      "youtube": "https://youtube.com/@Figranium",
      "instagram": "https://instagram.com/figranium"
    }
  },
  "redirects": [
    {
      "source": "/sdk/kotlin",
      "destination": "/sdk/kotlin/overview",
      "permanent": false
    },
    {
      "source": "/extraction-script-generation",
      "destination": "/data-extraction"
    }
  ],
  "background": {
    "color": {
      "dark": "#101114"
    }
  }
