{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Figranium Docs",
  "colors": {
    "primary": "#ffffff",
    "light": "#ffffff",
    "dark": "#ffffff"
  },
  "navigation": {
    "groups": [
      {
        "group": "Intro",
        "pages": [
          "overview",
          "architecture",
          "why-figranium",
          "pronunciation"
        ]
      },
      {
        "group": "Installation",
        "pages": [
          "host-specs",
          "docker-compose",
          "multi-arch",
          "configuration",
          "database-support",
          "local-development"
        ]
      },
      {
        "group": "Basics",
        "pages": [
          "ui-tour",
          "action-blocks",
          "selectors",
          "highlight-tool"
        ]
      },
      {
        "group": "Features",
        "pages": [
          "proxy-rotation",
          "captures-and-storage",
          "file-downloads",
          "headful-browser",
          "stateless-execution",
          "task-versioning",
          "task-scheduling",
          "output-providers"
        ]
      },
      {
        "group": "API",
        "pages": [
          "rest-api",
          "api-key",
          "mcp-integration"
        ]
      },
      {
        "group": "Agent Logic",
        "pages": [
          "variables",
          "advanced-templating",
          "control-flow",
          "error-handling",
          "javascript-execution",
          "data-extraction",
          "extraction-script-generation",
          "page-translation",
          "stealth-mode",
          "captcha-solving",
          "csv-processing",
          "modular-workflows"
        ]
      },
      {
        "group": "JavaScript SDK",
        "pages": [
          "sdk/js/overview",
          "sdk/js/installation",
          "sdk/js/quickstart",
          "sdk/js/client-configuration",
          "sdk/js/authentication",
          "sdk/js/request-options",
          "sdk/js/errors",
          "sdk/js/streaming",
          "sdk/js/actions",
          "sdk/js/variables",
          {
            "group": "Resources",
            "pages": [
              "sdk/js/resources/tasks",
              "sdk/js/resources/executions",
              "sdk/js/resources/schedules",
              "sdk/js/resources/cabinets",
              "sdk/js/resources/captures",
              "sdk/js/resources/credentials",
              "sdk/js/resources/browser",
              "sdk/js/resources/execution",
              "sdk/js/resources/settings",
              "sdk/js/resources/auth",
              "sdk/js/resources/health"
            ]
          }
        ]
      },
      {
        "group": "Integrations",
        "pages": [
          "community-presets",
          "n8n-integration",
          "zapier-integration",
          "dify-integration",
          "langflow-integration",
          "simplynode-integration",
          "digitalocean-one-click"
        ]
      },
      {
        "group": "Ops",
        "pages": [
          "performance",
          "security",
          "session-state",
          "troubleshooting"
        ]
      },
      {
        "group": "Changelog",
        "pages": [
          "changelog/overview"
        ]
      }
    ]
  },
  "favicon": {
    "light": "/images/favicon.svg",
    "dark": "/images/icon_light.svg"
  },
  "logo": {
    "light": "/images/favicon.svg",
    "dark": "/images/figranium_icon.svg",
    "href": "https://figranium.dev"
  },
  "css": "/styles.css",
  "appearance": {
    "strict": true,
    "default": "dark"
  },
  "seo": {
    "indexing": "navigable",
    "metatags": {
      "canonical": "https://figranium.dev/docs"
    }
  },
  "integrations": {
    "telemetry": {
      "enabled": true
    }
  },
  "errors": {
    "404": {
      "redirect": false
    }
  },
  "api": {
    "openapi": "openapi.json"
  },
  "markdown": {
    "schema": true
  },
  "icons": {
    "library": "tabler"
  },
  "fonts": {
    "family": "Questrial"
  }
}
